<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">


    <changeSet id="004-load-products-csv-data" author="kbosnjak">
        <loadData
                file="classpath:db/changelog/amazon_products_final.csv"
                tableName="products"
                schemaName="catalog"
                separator=","
                quotchar='"'
                encoding="UTF-8">
            <column name="id" type="NUMERIC"/>
            <column name="name" type="STRING"/>
            <column name="category" type="STRING"/>
            <column name="discounted_price" type="NUMERIC"/>
            <column name="actual_price" type="NUMERIC"/>
            <column name="discount_percentage" type="NUMERIC"/>
            <column name="rating" type="NUMERIC"/>
            <column name="rating_count" type="NUMERIC"/>
            <column name="about_product" type="STRING"/>
            <column name="img_link" type="STRING"/>
            <column name="product_link" type="STRING"/>
            <column name="specific_category" type="STRING"/>
            <column name="combined_text" type="STRING"/>
            <column name="image_name" type="STRING"/>
            <column name="image_path" type="STRING"/>
        </loadData>
    </changeSet>
</databaseChangeLog>
